NEXT_PUBLIC_SITE_URL=https://danielrubio.dev

# --- AI assistant (`ask` command) ---
# Provider switch: "groq" (default, free) or "openai" (paid fallback)
AI_PROVIDER=groq
# Master kill switch — set to "false" to force the canned fallback
AI_ENABLED=true

# Groq (free tier — console.groq.com). Default provider.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (only used when AI_PROVIDER=openai). Use a dedicated project + spend cap.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Abuse + budget guardrails (Upstash Redis — free tier). Without these the
# endpoint serves the canned fallback in production (fail-safe).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Hard global ceiling on live model calls per day
AI_DAILY_CAP=500
